@using Microsoft.AspNetCore.Html
@model JsonNodeInfo

@{
    string nodeId = Guid.NewGuid().ToString();
}

<li class="json-node">
    @if (Model.Children.Any())
    {
        <div>
            <button class="btn btn-sm btn-link p-0 toggle-button" type="button" data-bs-toggle="collapse" data-bs-target="#@nodeId" aria-expanded="True">
                <span>
                    ▼
                </span>
            </button>
            
            @NodeLabel()
        </div>
        
        <ul id="@nodeId" class="collapse show">
            @foreach (JsonNodeInfo child in Model.Children)
            {
                <partial name="_JsonNode" model="child" />
            }
            
            @if (Model.HasMoreChildren)
            {
                <li class="text-muted fst-italic">
                    ... @Model.RemainingChildren More Items
                </li>
            }
        </ul>
    }
    else
    {
        @NodeLabel()
    }
</li>

@functions {

    private IHtmlContent NodeLabel()
    {
        return Model.NodeType switch
        {
            "Object" => new HtmlString($"<strong>{Model.Name}</strong> <span class='badge bg-primary'>Object</span>"),
            "Array" => new HtmlString($"<strong>{Model.Name}</strong> <span class='badge bg-success'>Array ({Model.ChildCount})</span>"),
            _ => new HtmlString($"{Model.Name} <span class='badge bg-secondary'>{Model.ValueType}</span>"),
        };
    }
}