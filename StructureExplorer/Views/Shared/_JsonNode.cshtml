@using Microsoft.AspNetCore.Html
@model JsonNodeInfo

@{
    string nodeId = Guid.NewGuid().ToString();
}

<li class="json-node">
    @if (Model.Children.Any())
    {
        <div class="node-line">
            <button class="btn btn-sm btn-link p-0 toggle-button" type="button" data-bs-toggle="collapse" data-bs-target="#@nodeId" aria-expanded="True">
                <span>▼</span>
            </button>
            
            <span class="node-name">@Model.Name</span>
            
            @NodeType()
        </div>
        
        <ul id="@nodeId" class="collapse show">
            @foreach (JsonNodeInfo child in Model.Children)
            {
                <partial name="_JsonNode" model="child" />
            }
        </ul>
    }
    else
    {
        <div class="node-line">
            <span class="empty-toggle"></span>
            
            <span class="node-name">@Model.Name</span>
            
            @NodeType()
            
            @if (!string.IsNullOrWhiteSpace(Model.ValuePreview))
            {
                <span class="value-preview">
                    @Model.ValuePreview
                </span>
            }
            
            <span class="json-path">
                @Model.Path
            </span>
        </div>
    }
</li>

@functions
{
    private IHtmlContent NodeType()
    {
        return Model.NodeType switch
        {
            "Object" =>
                new HtmlString(
                    "<span class='node-type'>Object</span>"
                ),


            "Array" =>
                new HtmlString(
                    $"<span class='node-type'>Array [{Model.ChildCount}]</span>"
                ),


            "Value" =>
                new HtmlString(
                    $"<span class='node-type'>{Model.ValueType}</span>"
                ),


            _ =>
                HtmlString.Empty
        };
    }
}