@using System.Text.Json
@model JsonAnalysisResult

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Objects</h5>
                    <h2>@Model.ObjectCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Arrays</h5>
                    <h2>@Model.ArrayCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Values</h5>
                    <h2>@Model.PrimitiveCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Depth</h5>
                    <h2>@Model.MaxDepth</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-9">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    JSON Structure
                </div>

                <div class="card-body">
                    <ul class="json-tree">
                        @foreach (JsonNodeInfo node in Model.Root?.Children!)
                        {
                            <partial name="_JsonNode" model="node" />
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>